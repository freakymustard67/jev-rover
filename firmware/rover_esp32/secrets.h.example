// secrets.h.example
//
// Copy this file to `secrets.h` in the same directory as rover_esp32.ino
// and fill in your real network credentials:
//
//     cp secrets.h.example secrets.h
//
// IMPORTANT: add `secrets.h` to your .gitignore so real credentials are
// never committed. Example .gitignore line:
//
//     firmware/rover_esp32/secrets.h
//
// The build will fail with a clear #error if secrets.h is missing.

#pragma once

// ---------------------------------------------------------------
// WiFi credentials (EXAMPLE VALUES - replace with your own)
// ---------------------------------------------------------------
#define ROVER_WIFI_SSID     "MyRoverNetwork"
#define ROVER_WIFI_PASSWORD "hunter2-not-a-real-password"

// Optional: pin the rover to a static address (leave disabled to use DHCP).
// A fixed IP makes the laptop side simpler, since it always knows where to send.
// #define ROVER_STATIC_IP   // uncomment to enable
#ifdef ROVER_STATIC_IP
  #define ROVER_IP       192, 168, 4, 20
  #define ROVER_GATEWAY  192, 168, 4, 1
  #define ROVER_SUBNET   255, 255, 255, 0
#endif

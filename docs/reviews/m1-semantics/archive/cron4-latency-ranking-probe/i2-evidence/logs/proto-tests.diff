+def _bbox_and_probe(perc, synth_cfg, label, x, y, w, h):
+    bb = FakeVision.from_world([WorldFixture(label, x, y, w, h)], perc.homography).fixtures[0].bbox_px
+    bbox = (float(bb[0]), float(bb[1]), float(bb[2]), float(bb[3]))
+    return bbox

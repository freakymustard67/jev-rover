+    def required_standoff_m(self, obj_radius_m: float, margin_m: float = 0.05) -> float:
+        """Per-object safe standoff for routing to a destination (w4b rule).
+
+        Two envelopes act against the destination object once it is in the
+        occupancy grid: the planner block at ``obj_r + inflation + cell/2`` and
+        the executor stop envelopes (map_brake at a 0.30 m surface gap; the
+        no-Jev blocked-turn at ~0.35 m). Standoff must clear both plus margin;
+        rounded up to 5 cm. With the shipped constants this is ``obj_r + 0.35``
+        (e.g. 0.65 m for r = 0.30, 0.75 m for r = 0.40). A closer standoff is
+        reachable only via the free-space projection
+        (``control.Planner.project_to_free``).
+        """
+        reflex_floor = 0.30          # map_brake stop gap, control.py _reflex
+        floor = max(self.grid.inflation_m + self.grid.cell_m / 2.0, reflex_floor)
+        need = obj_radius_m + floor + margin_m
+        return math.ceil(need / 0.05 - 1e-9) * 0.05
+
     def to_dict(self) -> dict:
         out = asdict(self)
         # Native JSON types for the config round-trip.

diff --git a/tests/test_approach_standoff.py b/tests/test_approach_standoff.py
new file mode 100644
index 0000000..424a232
--- /dev/null
+++ b/tests/test_approach_standoff.py
@@ -0,0 +1,124 @@
+"""Approach standoff vs the planner's inflated region (w4b audit; fixes F1/F2).
+
+A destination object stamped into the occupancy grid blocks an inflated disc of
+radius ~obj_r + inflation. An approach ring closer than that is silently
+substituted by the planner, so:
+
+* the executed path must end at the free substitute, never at the raw blocked
+  goal (F2 -- otherwise ``path_valid``/``path_bearing_deg`` lie);
+* callers project the goal to free space via ``Planner.project_to_free`` (F1);
+* the per-object standoff rule (``RoomConfig.required_standoff_m``) keeps the
+  ring outside both the planner block and the executor's stop envelopes.
+"""
+import numpy as np
+import pytest
+
+from config import ConfigError, RoomConfig
+from control import Executor, Planner
+from perception import OccupancyGrid
+from scene import Destination, GoalInfo, Scene
+from semantics import approach_point
+
+OBJ = (2.0, 2.0)
+START = (0.7, 2.0)
+
+
+def _grid_with_disc(obj_xy=OBJ, obj_r=0.30):
+    """Wall ring + a disc obstacle stamped the way perception stamps cells."""
+    grid = OccupancyGrid(4.0, 4.0, 0.05)
+    wall = np.zeros((grid.h, grid.w), bool)
+    wall[[0, -1], :] = True
+    wall[:, [0, -1]] = True
+    grid.set_occupied(wall, 0.0)
+    step = 0.01
+    xs = np.arange(obj_xy[0] - obj_r, obj_xy[0] + obj_r + 1e-9, step)
+    ys = np.arange(obj_xy[1] - obj_r, obj_xy[1] + obj_r + 1e-9, step)
+    xx, yy = np.meshgrid(xs, ys)
+    m = (xx - obj_xy[0]) ** 2 + (yy - obj_xy[1]) ** 2 <= obj_r ** 2
+    grid.update(np.zeros((0, 2)), np.column_stack([xx[m], yy[m]]), 0.0)
+    return grid
+
+
+def _cell(p, grid):
+    return min(int(p[0] / grid.cell_m), grid.w - 1), min(int(p[1] / grid.cell_m), grid.h - 1)
+
+
+def test_plan_never_ends_on_a_blocked_goal_cell():
+    cfg = RoomConfig()
+    grid = _grid_with_disc()
+    planner = Planner(grid, cfg.grid.inflation_m, cfg)
+    dest = Destination(label="mat", x=OBJ[0], y=OBJ[1], confidence=0.9)
+    ax, ay = approach_point(dest, START, cfg.destination.standoff_m)   # the 0.35 m ring
+
+    blocked = planner.blocked()
+    assert blocked[_cell((ax, ay), grid)[1], _cell((ax, ay), grid)[0]], \
+        "precondition: the 0.35 m approach cell lies inside the inflated region"
+
+    path, _ = planner.plan(START, (ax, ay), 0.0)
+    assert path, "planner found no path to the substitute"
+    end = path[-1]
+    assert end != (ax, ay), "blocked goal was spliced back onto the path (F2 regression)"
+    ix, iy = _cell(end, grid)
+    assert not blocked[iy, ix], "final waypoint is a blocked cell"
+    # and it is exactly the point project_to_free tells callers to aim at (F1)
+    assert planner.project_to_free((ax, ay)) == end
+
+
+def test_executor_replan_ends_at_the_substitute_not_the_raw_goal():
+    cfg = RoomConfig()
+    grid = _grid_with_disc()
+    ex = Executor(cfg, grid)
+    dest = Destination(label="mat", x=OBJ[0], y=OBJ[1], confidence=0.9)
+    ax, ay = approach_point(dest, START, cfg.destination.standoff_m)
+    scene = Scene()
+    scene.pose.x, scene.pose.y = START
+    scene.goal = GoalInfo(type="goto", name="dest", x=ax, y=ay)
+    ex._replan(scene, 0.0)
+    assert ex.path and ex.path[-1] != (ax, ay)
+    assert ex.path[-1] == ex.planner.project_to_free((ax, ay))
+
+
+def test_plan_keeps_the_exact_goal_when_its_cell_is_free():
+    cfg = RoomConfig()
+    grid = _grid_with_disc()
+    planner = Planner(grid, cfg.grid.inflation_m, cfg)
+    goal = (1.1, 1.4)
+    path, _ = planner.plan(START, goal, 0.0)
+    assert path and path[-1] == goal, "free goal must be published exactly"
+    assert planner.project_to_free(goal) == goal
+
+
+def test_required_standoff_clears_planner_and_reflex_envelopes():
+    cfg = RoomConfig()
+    for r in (0.15, 0.30, 0.40):
+        need = cfg.required_standoff_m(r)
+        assert need >= r + cfg.grid.inflation_m + cfg.grid.cell_m, \
+            "standoff must clear the planner block (inflation + cell)"
+        assert need >= r + 0.30 + 0.05, "standoff must clear the map_brake envelope"
+        assert need >= r + 0.35, "w4b rule with the shipped constants"
+        assert abs(need / 0.05 - round(need / 0.05)) < 1e-9, "rounded to 5 cm"
+    assert cfg.required_standoff_m(0.30) == 0.65
+    assert cfg.required_standoff_m(0.40) == 0.75
+
+
+def test_rule_standoff_ring_is_planner_free():
+    """At the per-object standoff the ring must not need projection (r=0.30)."""
+    cfg = RoomConfig()
+    grid = _grid_with_disc()
+    planner = Planner(grid, cfg.grid.inflation_m, cfg)
+    standoff = cfg.required_standoff_m(0.30)
+    ax, ay = approach_point(Destination("mat", OBJ[0], OBJ[1], 0.9), START, standoff)
+    assert planner.project_to_free((ax, ay)) == (ax, ay)
+
+
+def test_config_rejects_standoff_below_the_planner_floor(synth_cfg):
+    raw = synth_cfg.to_dict()
+    floor = synth_cfg.grid.inflation_m + synth_cfg.grid.cell_m
+    raw["destination"]["standoff_m"] = floor - 0.01        # 0.26 < 0.27 floor
+    with pytest.raises(ConfigError, match="standoff_m"):
+        RoomConfig.from_dict(raw)
+    raw["destination"]["standoff_m"] = 0.20                # far below: still rejected
+    with pytest.raises(ConfigError, match="standoff_m"):
+        RoomConfig.from_dict(raw)
+    raw["destination"]["standoff_m"] = floor + 0.05        # at the floor + margin: OK
+    RoomConfig.from_dict(raw)
-- 

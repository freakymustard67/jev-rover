From c3c5c84e715087096e7140ab487c33bc8deb3eb2 Mon Sep 17 00:00:00 2001
From: Hermes Fix Package <hermes@local>
Date: Tue, 29 Sep 2026 00:55:42 +0530
Subject: [PATCH 09/12] semantics: count cooldown refusals in skipped stats

The failure-cooldown branch returned False without touching any counter, so
acceptance #4's 'cooldown counters visible in summary' was unmet. Add
skipped['cooldown'] and pin the full skipped key set in the stats test.

Tests: tests/test_semantics_worker.py::test_failure_cooldown
       tests/test_semantics_worker.py::test_stats_shape
---
 semantics.py                   | 3 ++-
 tests/test_semantics_worker.py | 3 +++
 2 files changed, 5 insertions(+), 1 deletion(-)

diff --git a/semantics.py b/semantics.py
index 9978ef5..8af1d33 100644
--- a/semantics.py
+++ b/semantics.py
@@ -566,7 +566,7 @@ class SemanticsRunner:
         self.last_offer_t = float("-inf")
         self.fail_cooldown_until = float("-inf")
         self.skipped = {"interval": 0, "budget": 0, "inflight": 0, "no_context": 0,
-                        "resolution": 0}
+                        "resolution": 0, "cooldown": 0}
         self.stale_dropped = 0
         self._resolution_warned = False
 
@@ -594,6 +594,7 @@ class SemanticsRunner:
         # Cooldown and budget are hard limits: even an explicit trigger respects
         # them, so a bug cannot run up a bill or hammer a failing model.
         if t < self.fail_cooldown_until:
+            self.skipped["cooldown"] += 1
             return False
         if not force and t - self.last_offer_t < self.semantics_cfg.min_interval_s:
             self.skipped["interval"] += 1
diff --git a/tests/test_semantics_worker.py b/tests/test_semantics_worker.py
index 03cda48..05545c0 100644
--- a/tests/test_semantics_worker.py
+++ b/tests/test_semantics_worker.py
@@ -115,6 +115,7 @@ def test_failure_cooldown(tmp_path):
         assert _drain(runner, 0.05) is None
         assert runner.worker.errors == 1
         assert not runner.maybe_pass(1.0, _ctx(), FRAME, force=True), "cooldown must block"
+        assert runner.skipped["cooldown"] == 1, "cooldown refusals are counted"
         assert runner.maybe_pass(20.0, _ctx(), FRAME, force=True), "cooldown must expire"
     finally:
         runner.close()
@@ -157,5 +158,7 @@ def test_stats_shape(tmp_path):
         stats = runner.stats()
         assert stats["enabled"] is True and stats["passes"] == 0
         assert "median_ms" in stats and "skipped" in stats
+        assert set(stats["skipped"]) == {"interval", "budget", "inflight", "no_context",
+                                         "resolution", "cooldown"}
     finally:
         runner.close()
-- 

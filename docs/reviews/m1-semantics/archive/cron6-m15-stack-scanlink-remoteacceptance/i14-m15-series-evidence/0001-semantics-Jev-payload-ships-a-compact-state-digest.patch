--- a/scene.py
+++ b/scene.py
@@ -298,6 +298,14 @@ class SemanticDiff:
     vanished: list[str] = field(default_factory=list)
 
 
+#: Jev payload compaction (M3 prototype; measured in the w3c state-cost audit).
+#: Everything written to disk or logs keeps the full schema through
+#: ``Scene.to_dict()``; only the Jev view ships the digest below.
+JEV_MAX_OBJECTS = 25           # cap on the shipped list, nearest-to-rover first
+JEV_MIN_CONFIDENCE = 0.5       # mirrors SemanticsConfig.min_confidence
+JEV_DIFF_IDS = 3               # first N ids kept per diff bucket
+
+
 @dataclass
 class SemanticMap:
     age_s: float = 0.0
@@ -307,6 +315,57 @@ class SemanticMap:
     destination: Destination | None = None
     diff: SemanticDiff = field(default_factory=SemanticDiff)
 
+    def jev_digest(self, pose: tuple[float, float] | None = None,
+                   max_objects: int = JEV_MAX_OBJECTS,
+                   min_confidence: float = JEV_MIN_CONFIDENCE) -> dict[str, Any]:
+        """Compact Jev-facing view: labels, 2-dp positions, confidence.
+
+        What a judgment can act on, and nothing else: per object only
+        ``label``/``x``/``y``/``confidence`` (``height_suspect``/``motion``
+        appear only when set); map ``age_s``/``passes``/``model``; the
+        destination; and a counts-only ``diff``. Objects below
+        ``min_confidence`` can never be destinations, so they are dropped;
+        the list is capped at ``max_objects`` nearest to ``pose``, with the
+        remainder counted in ``objects_more``.
+        """
+        shippable = [o for o in self.objects if o.confidence >= min_confidence]
+        if pose is not None:
+            shippable.sort(key=lambda o: ((o.x - pose[0]) ** 2 + (o.y - pose[1]) ** 2,
+                                          o.label, o.x, o.y))
+        objects: list[dict[str, Any]] = []
+        for o in shippable[:max_objects]:
+            entry: dict[str, Any] = {"label": o.label, "x": round(o.x, 2),
+                                     "y": round(o.y, 2), "confidence": o.confidence}
+            if o.height_suspect:
+                entry["height_suspect"] = True
+            if o.motion != "static":
+                entry["motion"] = o.motion
+            objects.append(entry)
+        diff: dict[str, Any] = {"appeared": len(self.diff.appeared),
+                                "moved": len(self.diff.moved),
+                                "vanished": len(self.diff.vanished)}
+        for bucket in ("appeared", "moved", "vanished"):
+            ids = getattr(self.diff, bucket)
+            if ids:
+                diff[f"{bucket}_ids"] = list(ids[:JEV_DIFF_IDS])
+        view: dict[str, Any] = {
+            "age_s": self.age_s,
+            "passes": self.passes,
+            "model": self.model,
+            "objects": objects,
+            "destination": ({"label": self.destination.label,
+                             "x": round(self.destination.x, 2),
+                             "y": round(self.destination.y, 2),
+                             "confidence": self.destination.confidence,
+                             "source": self.destination.source,
+                             "object_id": self.destination.object_id}
+                            if self.destination is not None else None),
+            "diff": diff,
+        }
+        if len(shippable) > max_objects:
+            view["objects_more"] = len(shippable) - max_objects
+        return view
+
 
 @dataclass
 class SweepConfirmation:

+def test_state_size_bound_on_the_real_path(synth_cfg, tmp_path):
+    """m1-plan.md:345, on the path the bound is about: 20 realistic objects
+    through SyntheticRoom -> Perception -> FakeVision -> store -> snapshot ->
+    build_state. The Jev payload (digest) must stay under the 6 KB bound; the
+    full disk schema may be larger but stays bounded too."""
+    cfg, perc, frame = _warm(synth_cfg, tmp_path)
+    scene = perc.process(frame, 1.0)
+    vision = FakeVision.from_world([WorldFixture(*e) for e in ROOM_ROSTER_20],
+                                   perc.homography)
+    runner = SemanticsRunner(cfg, "synth", vision)
+    try:
+        merged = _pass(runner, perc, frame, 1.0)
+        assert merged is not None
+        assert len(merged.objects) == 20, f"expected 20 map objects, got {len(merged.objects)}"
+        scene.semantics = runner.snapshot(1.5)
+    finally:
+        runner.close()
+    state = build_state(scene)
+    digest_bytes = len(json.dumps(state))
+    assert digest_bytes < 6000, f"Jev digest payload: {digest_bytes} bytes"
+    disk_bytes = len(json.dumps(scene.to_dict()))
+    assert disk_bytes < 10_000, f"full scene.to_dict(): {disk_bytes} bytes"

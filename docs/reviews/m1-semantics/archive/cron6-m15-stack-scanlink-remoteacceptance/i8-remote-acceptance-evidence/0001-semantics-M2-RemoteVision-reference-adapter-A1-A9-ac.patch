+# ======================================================================= A7
+@pytest.mark.parametrize("mode, timeout_s, needle", [
+    ("slow", 0.15, "Timeout"),
+    ("http500", 2.0, "HTTP 500: Internal Server Error"),
+    ("malformed", 2.0, "malformed JSON"),
+    ("schema", 2.0, "schema: expected"),
+    ("allinvalid", 2.0, "all 1 detection entries malformed"),
+    ("refused", 2.0, "Connection refused"),
+], ids=["timeout", "http-500", "malformed-json", "wrong-schema",
+        "all-invalid", "connection-refused"])
+def test_a7_failure_isolated_then_recovery(tmp_path, mock, monkeypatch,
+                                           mode, timeout_s, needle):
+    """w4c driver scenario port: clean error, thread alive, cooldown, recovery."""
+    if mode == "refused":
+        monkeypatch.setenv(ENDPOINT_ENV, f"http://127.0.0.1:{dead_port()}/detect")
+    else:
+        monkeypatch.setenv(ENDPOINT_ENV, mock.url)
+        mock.mode = mode
+    vision = RemoteVision(timeout_s=timeout_s, labels=["mat", "bottle"])
+    runner = _runner(vision, tmp_path, failure_cooldown_s=5.0, min_interval_s=0.0,
+                     max_passes_per_min=200)
+    tb = 100.0
+    try:
+        assert runner.maybe_pass(tb, _ctx(), FRAME, force=True)
+        assert _wait_error(runner, 1)
+        _consume_error(runner, tb)
+        err = runner.worker.last_error or ""
+        assert err.startswith("RemoteVisionError: "), err
+        assert needle in err, err
+        assert abs(runner.fail_cooldown_until - (tb + 5.0)) < 1e-6
+        assert not runner.maybe_pass(tb + 1.0, _ctx(), FRAME, force=True)
+        assert runner.skipped["cooldown"] == 1
+        assert runner.worker._thread.is_alive()
+        assert runner._inflight is None
+        mock.mode = "ok"                               # recovery
+        monkeypatch.setenv(ENDPOINT_ENV, mock.url)
+        assert runner.maybe_pass(tb + 5.0, _ctx(), FRAME, force=True)
+        merged = _drain(runner, tb + 5.0)
+        assert merged is not None and runner.store.passes == 1
+        assert [o.label for o in merged.objects] == ["mat", "bottle"]
+    finally:
+        runner.close()
+

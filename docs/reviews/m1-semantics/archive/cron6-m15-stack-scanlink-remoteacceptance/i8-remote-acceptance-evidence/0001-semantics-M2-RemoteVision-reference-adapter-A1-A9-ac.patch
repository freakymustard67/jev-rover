+"""RemoteVision — M2 remote-vision adapter (forward-landing reference + A1–A9).
+
+This module is the *planned* M2 seam (docs/reviews/m1-semantics/m2-design.md §2.4)
+built ahead of the M2 branch, hardened against the failure modes catalogued in
+the W4C threat model (runs/20260928-2057/w4c-remotevision-threat.md §4/§5).
+It does not wire itself in: ``semantics.build_vision`` still raises for every
+non-fake kind at PR tip bec1d91; M2 replaces that raise with a construction
+of ``RemoteVision`` from ``SemanticsConfig.model`` (see "M2 wiring" below).
+
+Contract (implements the ``semantics.VisionModel`` protocol — semantics.py:64-68)
+--------------------------------------------------------------------------------
+* endpoint: env ``JEV_ROVER_VISION_ENDPOINT`` wins; else the constructor arg
+  (``semantics.model.endpoint``). Both empty → ``RemoteVisionError`` naming both
+  sources. The effective endpoint is re-validated on every call (A3/A8).
+* token: env ``JEV_ROVER_VISION_TOKEN``, read *at call time*, sent **only** as an
+  ``Authorization: Bearer …`` header, never in the URL or body, never stored, and
+  defensively scrubbed from every error string (A6).
+* request: one POST per pass, JSON — ``{"protocol": 1, "request_id", "labels",
+  "image_b64", "width", "height", "format": "jpeg", "timeout_ms"}``; the JPEG
+  encode happens on the caller's (worker) thread, never the control loop.
+* response: must echo ``protocol`` (A1) and carry ``{"detections": [...]}``;
+  every entry is validated (label, 4 finite bbox numbers, non-degenerate,
+  inside the sent image ±8 px, finite/clamped score). Malformed entries are
+  skipped and counted; **if every entry is malformed the pass fails loudly**
+  instead of returning an empty room (threat #6/D2).
+* every failure raises (``RemoteVisionError`` or a clean stdlib error), so
+  ``SemanticsWorker._run``'s blanket except (semantics.py:542-547) turns it into
+  a ``PassResult(error)`` and ``SemanticsRunner.poll`` arms the runner cooldown
+  (semantics.py:625-627). **One HTTP attempt per pass, no retries** — the runner
+  owns all rate limiting (A4).
+* ``name`` is a static class constant (A9): it is serialized into
+  ``*_latest.json`` as ``map.model`` (semantics.py:399-400 → 417-421), so it must
+  never carry an endpoint, scheme or token.
+
+A-item map: A1 protocol echo + model/ms telemetry; A2 size caps (1 MiB response,
+frame-px cap before encode, MAX_DETECTIONS=64); A3 plaintext/TLS policy and
+endpoint hygiene (no userinfo/query, loopback or explicit opt-in only, no redirect
+following, environment proxies ignored); A4 one attempt per pass; A6 secret
+hygiene; A8 validation bounds (``0 < timeout_s <= min(max_age_s, 60)``, labels
+required for real kinds) with errors naming both the config key and the env var;
+A9 static name.
+
+Divergences from m2-design (flagged in the W4C report, unchanged here):
+D1 request uses a flat ``image_b64`` (this pack's brief) rather than the nested
+``image{format,b64,width,height,scale}``; D3 env names follow m2-design
+(``JEV_ROVER_VISION_*``) rather than the w4c prototype's shorter names.
+
+M2 wiring (one-line call sites, not done here):
+  1. ``semantics.build_vision``: ``kind == "remote"`` → ``RemoteVision(
+     cfg.model.endpoint, cfg.model.timeout_s, labels=cfg.model.labels,
+     max_age_s=cfg.max_age_s, allow_plaintext_lan=cfg.model.allow_plaintext_lan,
+     jpeg_quality=cfg.model.jpeg_quality)``.
+  2. ``SemanticsWorker._run`` (semantics.py:541): pass through
+     ``getattr(vision, "last_model", None)`` / ``getattr(vision, "last_ms", None)``
+     in ``PassResult`` (m2-design.md:464).
+  3. ``config._validate_semantics``: call ``validate_remote_settings(...)`` for
+     ``kind in ("local", "remote")`` so bounds fail at load, not at first pass.
+"""
+from __future__ import annotations
+
+import base64
+import http.client
+import ipaddress
+import json
+import math
+import os
+import re
+import socket
+import urllib.error
+import urllib.parse
+import urllib.request
+import uuid
+from typing import Any, Sequence
+
+import cv2
+import numpy as np
+
+from semantics import MAX_DETECTIONS, Detection
+
+# ---------------------------------------------------------------- constants
+ENDPOINT_ENV = "JEV_ROVER_VISION_ENDPOINT"     # m2-design.md:346
+TOKEN_ENV = "JEV_ROVER_VISION_TOKEN"           # m2-design.md:401
+PROTOCOL = 1                                   # m2-design.md:321
+NAME = "remote-vision-v1"                      # A9: static, artifact-safe
+MAX_RESPONSE_BYTES = 1024 * 1024               # A2: 1 MiB response read cap
+MAX_FRAME_PX = 8_000_000                       # A2: frame-px cap before encode
+TIMEOUT_CAP_S = 60.0                           # A8: absolute timeout ceiling
+MAX_MODEL_CHARS = 64                           # A1: telemetry sanitization
+PLAINTEXT_LOOPBACK = ("localhost",)            # plus ipaddress.is_loopback hosts
+
+_ENDPOINT_SOURCES = f"semantics.model.endpoint / env {ENDPOINT_ENV}"
+_SCRUB_MIN_LEN = 4          # shorter tokens would mangle unrelated text
+
+
+class RemoteVisionError(RuntimeError):
+    """Any remote-adapter / remote-config failure. Deliberately token-scrubbed."""
+
+
+def _scrub(text: str, token: str | None = None) -> str:
+    """Defense in depth (A6): no error string may contain the token.
+
+    Scrubs the raw token plus its URL-quoted and base64 forms (>= 4 chars).
+    """
+    tok = token if token is not None else os.environ.get(TOKEN_ENV, "")
+    if not tok:
+        return text
+    forms = {tok}
+    try:
+        forms.add(urllib.parse.quote(tok, safe=""))
+    except Exception:                                     # pragma: no cover
+        pass
+    forms.add(base64.b64encode(tok.encode("utf-8", "ignore")).decode("ascii"))
+    for form in sorted(forms, key=len, reverse=True):
+        if len(form) >= _SCRUB_MIN_LEN:
+            text = text.replace(form, "***")
+    return text
+
+
+def _is_loopback(host: str | None) -> bool:
+    if not host:
+        return False
+    h = host.strip("[]").lower()
+    if h in PLAINTEXT_LOOPBACK:
+        return True
+    try:
+        return ipaddress.ip_address(h).is_loopback
+    except ValueError:
+        return False
+
+
+# ------------------------------------------------------------- validation (A8)
+def validate_endpoint(url: str, *, allow_plaintext_lan: bool = False) -> urllib.parse.SplitResult:
+    """Validate an endpoint URL; returns its parsed form or raises (A3/A8).
+
+    Policy: scheme must be http/https; no ``user:pass@`` userinfo; no query
+    string or fragment (both are classic places to smuggle a token); a host is
+    required; plaintext http is only allowed for loopback hosts or when
+    ``allow_plaintext_lan`` is explicitly set. Messages name the config key and
+    the env var so an operator knows which of the two sources to fix.
+    """
+    try:
+        parts = urllib.parse.urlsplit(str(url).strip())
+    except ValueError as e:
+        raise RemoteVisionError(
+            f"endpoint rejected ({_ENDPOINT_SOURCES}): unparseable URL ({type(e).__name__})"
+        ) from None
+    if parts.scheme not in ("http", "https"):
+        raise RemoteVisionError(
+            f"endpoint rejected ({_ENDPOINT_SOURCES}): scheme must be http:// or "
+            f"https://, got {parts.scheme or '<none>'!r}"
+        )
+    if parts.username is not None or parts.password is not None:
+        raise RemoteVisionError(
+            f"endpoint rejected ({_ENDPOINT_SOURCES}): embedded credentials "
+            f"(user:pass@) are not allowed — the token comes from env {TOKEN_ENV}"
+        )
+    if parts.query or parts.fragment:
+        raise RemoteVisionError(
+            f"endpoint rejected ({_ENDPOINT_SOURCES}): query strings and fragments "
+            f"are not allowed — the token comes from env {TOKEN_ENV}"
+        )
+    if not parts.hostname:
+        raise RemoteVisionError(
+            f"endpoint rejected ({_ENDPOINT_SOURCES}): missing host")
+    try:
+        parts.port
+    except ValueError:
+        raise RemoteVisionError(
+            f"endpoint rejected ({_ENDPOINT_SOURCES}): invalid port") from None
+    if parts.scheme == "http" and not (allow_plaintext_lan or _is_loopback(parts.hostname)):
+        raise RemoteVisionError(
+            f"endpoint rejected ({_ENDPOINT_SOURCES}): plaintext http is only allowed "
+            f"for loopback hosts, or with allow_plaintext_lan: true (an explicit "
+            f"opt-in: frames and the token then leave the host unencrypted)"
+        )
+    return parts
+
+
+def validate_remote_settings(*, endpoint: str = "", timeout_s: float = 10.0,
+                             labels: Sequence[str] = (), max_age_s: float = 30.0,
+                             allow_plaintext_lan: bool = False,
+                             jpeg_quality: int = 85,
+                             kind: str = "remote") -> None:
+    """Validate the M2 remote knobs at load (A8); raises ``RemoteVisionError``.
+
+    ``timeout_s`` must satisfy ``0 < timeout_s <= min(max_age_s, 60)``: a pass
+    slower than ``max_age_s`` would be merged never (stale-drop, semantics.py:628-630)
+    and 60 s is the absolute ceiling for a control-loop caller. A real kind
+    (``local``/``remote``) needs a non-empty prompt (``labels``). An endpoint —
+    when one is given — must pass ``validate_endpoint``.
+    """
+    where = "semantics.model"
+    if (not isinstance(timeout_s, (int, float)) or isinstance(timeout_s, bool)
+            or not math.isfinite(float(timeout_s))):
+        raise RemoteVisionError(f"{where}.timeout_s must be a finite number, got {timeout_s!r}")
+    cap = min(max_age_s, TIMEOUT_CAP_S) if (
+        isinstance(max_age_s, (int, float)) and not isinstance(max_age_s, bool)
+        and math.isfinite(float(max_age_s)) and max_age_s > 0) else TIMEOUT_CAP_S
+    if not (0 < timeout_s <= cap):
+        raise RemoteVisionError(
+            f"{where}.timeout_s must satisfy 0 < timeout_s <= {cap} "
+            f"(= min(semantics.max_age_s, {TIMEOUT_CAP_S})); got {timeout_s}"
+        )
+    if kind in ("local", "remote") and not [str(x).strip() for x in labels if str(x).strip()]:
+        raise RemoteVisionError(
+            f"{where}.labels must name at least one prompt label for kind={kind!r} "
+            f"(a real model with no prompt can only return nothing)"
+        )
+    if not (isinstance(jpeg_quality, int) and not isinstance(jpeg_quality, bool)
+            and 1 <= jpeg_quality <= 100):
+        raise RemoteVisionError(f"{where}.jpeg_quality must be within [1, 100], got {jpeg_quality!r}")
+    if str(endpoint).strip():
+        validate_endpoint(endpoint, allow_plaintext_lan=allow_plaintext_lan)
+
+
+def resolve_endpoint(configured: str = "") -> str:
+    """Env wins, then the configured endpoint; empty → error naming both (A8)."""
+    env_url = os.environ.get(ENDPOINT_ENV, "").strip()
+    url = env_url or str(configured).strip()
+    if not url:
+        raise RemoteVisionError(
+            f"remote vision endpoint is not set: {_ENDPOINT_SOURCES} are both empty"
+        )
+    return url
+
+
+# ------------------------------------------------------------- transport (A3)
+class _NoRedirect(urllib.request.HTTPRedirectHandler):
+    """Never follow redirects: a cross-host 30x would resend the token (threat #9)."""
+
+    def redirect_request(self, req, fp, code, msg, headers, newurl):   # noqa: D102
+        return None
+
+
+def build_opener() -> urllib.request.OpenerDirector:
+    """Default opener: no redirect following, environment proxies ignored (threat #10)."""
+    return urllib.request.build_opener(urllib.request.ProxyHandler({}), _NoRedirect())
+
+
+def _default_opener(req: urllib.request.Request, timeout: float | None = None):
+    return _DEFAULT_OPENER.open(req, timeout=timeout)
+
+
+_DEFAULT_OPENER = build_opener()
+
+
+# ------------------------------------------------------------------- parsing
+def _clean_model(value: Any) -> str | None:
+    """A1: sanitize a server-reported model string for logs/telemetry."""
+    if not isinstance(value, str):
+        return None
+    text = re.sub(r"[^\x20-\x7e]", "", value).strip()[:MAX_MODEL_CHARS]
+    return text or None
+
+
+def _clean_ms(value: Any) -> int | None:
+    if isinstance(value, bool) or not isinstance(value, (int, float)):
+        return None
+    v = float(value)
+    if not math.isfinite(v) or v < 0 or v > 86_400_000:
+        return None
+    return int(v)
+
+
+def _parse_entry(item: Any, w: int, h: int) -> Detection | None:
+    """Validate one detection entry; None = malformed (skipped, counted)."""
+    if not isinstance(item, dict):
+        return None
+    label = item.get("label")
+    bbox = item.get("bbox_px")
+    score = item.get("score", 1.0)
+    if not isinstance(label, str) or not label.strip():
+        return None
+    if (not isinstance(bbox, (list, tuple)) or len(bbox) != 4
+            or not all(isinstance(v, (int, float)) and not isinstance(v, bool)
+                       and math.isfinite(v) for v in bbox)):
+        return None
+    x0, y0, x1, y1 = (float(v) for v in bbox)
+    if x1 <= x0 or y1 <= y0:                                   # degenerate box
+        return None
+    pad = 8.0                                                  # rounding tolerance
+    if x0 < -pad or y0 < -pad or x1 > w + pad or y1 > h + pad:  # outside sent image
+        return None
+    if (not isinstance(score, (int, float)) or isinstance(score, bool)
+            or not math.isfinite(score)):
+        return None
+    score = min(1.0, max(0.0, float(score)))
+    return Detection(label, (int(round(x0)), int(round(y0)),
+                             int(round(x1)), int(round(y1))), score)
+
+
+def _encode_jpeg(frame: np.ndarray, quality: int, max_px: int, w: int, h: int) -> bytes:
+    """A2: px cap is enforced *before* any encode work."""
+    if w * h > max_px:
+        raise RemoteVisionError(
+            f"frame too large to encode: {w}x{h} ({w * h} px) exceeds the {max_px} px cap")
+    ok, buf = cv2.imencode(".jpg", frame, [cv2.IMWRITE_JPEG_QUALITY, int(quality)])
+    if not ok:                                                 # pragma: no cover
+        raise RemoteVisionError("JPEG encode failed")
+    return buf.tobytes()
+
+
+class RemoteVision:
+    """HTTP vision adapter: one POST per pass, env-only secrets, static name."""
+
+    name = NAME                                               # A9: class constant
+
+    def __init__(self, endpoint: str = "", timeout_s: float = 10.0, *,
+                 labels: Sequence[str] = (), max_age_s: float = 30.0,
+                 allow_plaintext_lan: bool = False, jpeg_quality: int = 85,
+                 max_frame_px: int = MAX_FRAME_PX,
+                 response_cap: int = MAX_RESPONSE_BYTES, opener=None):
+        validate_remote_settings(endpoint=endpoint, timeout_s=timeout_s, labels=labels,
+                                 max_age_s=max_age_s,
+                                 allow_plaintext_lan=allow_plaintext_lan,
+                                 jpeg_quality=jpeg_quality)
+        self._endpoint_cfg = str(endpoint or "")
+        self.timeout_s = float(timeout_s)
+        self.labels = [str(x) for x in labels]
+        self.max_age_s = float(max_age_s)
+        self.allow_plaintext_lan = bool(allow_plaintext_lan)
+        self.jpeg_quality = int(jpeg_quality)
+        self.max_frame_px = int(max_frame_px)
+        self.response_cap = int(response_cap)
+        self._opener = opener or _default_opener
+        # A1/A2 telemetry (sanitized; never carries the token or the endpoint)
+        self.last_protocol: int | None = None
+        self.last_model: str | None = None
+        self.last_ms: int | None = None
+        self.last_request_id: str | None = None
+        self.last_skipped = 0
+        self.last_truncated = 0
+
+    # ------------------------------------------------------------------ util
+    def _effective_endpoint(self) -> str:
+        return resolve_endpoint(self._endpoint_cfg)
+
+    def telemetry(self) -> dict[str, Any]:
+        """A1: the safe subset worth surfacing in stats()/PassResult."""
+        return {"protocol": self.last_protocol, "model": self.last_model,
+                "ms": self.last_ms, "request_id": self.last_request_id,
+                "skipped": self.last_skipped, "truncated": self.last_truncated}
+
+    # ----------------------------------------------------------------- infer
+    def infer(self, frame: np.ndarray, *, labels: list[str] | None = None) -> list[Detection]:
+        """One POST, one attempt. Raises RemoteVisionError on any failure (A4)."""
+        try:
+            return self._infer_once(frame, labels=labels)
+        except RemoteVisionError as e:
+            msg = _scrub(str(e))
+            if msg != str(e):
+                raise RemoteVisionError(msg) from None
+            raise
+
+    def _infer_once(self, frame: np.ndarray, *, labels: list[str] | None) -> list[Detection]:
+        url = self._effective_endpoint()
+        parts = validate_endpoint(url, allow_plaintext_lan=self.allow_plaintext_lan)
+        want = [str(x) for x in (self.labels if labels is None else labels)]
+        if not want:
+            raise RemoteVisionError(
+                "remote vision labels are empty: semantics.model.labels (or the "
+                "labels= argument) must name at least one prompt label for a remote model")
+        if frame is None or not isinstance(frame, np.ndarray) or frame.ndim != 3:
+            raise RemoteVisionError("expected a BGR frame (H, W, 3) to send")
+        h, w = int(frame.shape[0]), int(frame.shape[1])
+        if h <= 0 or w <= 0:
+            raise RemoteVisionError(f"bad frame shape: {frame.shape}")
+        jpeg = _encode_jpeg(frame, self.jpeg_quality, self.max_frame_px, w, h)
+
+        request_id = uuid.uuid4().hex[:12]
+        self.last_request_id = request_id
+        payload = {
+            "protocol": PROTOCOL,
+            "request_id": request_id,
+            "labels": want,
+            "image_b64": base64.b64encode(jpeg).decode("ascii"),
+            "width": w,
+            "height": h,
+            "format": "jpeg",
+            "timeout_ms": int(round(self.timeout_s * 1000)),
+        }
+        headers = {"Content-Type": "application/json"}
+        token = os.environ.get(TOKEN_ENV, "")
+        if token:
+            # Header only: never in the URL (config-visible, may be logged) and
+            # never in the body (bodies get captured). A3: only over a transport
+            # the policy allows (https, loopback, or the explicit LAN opt-in).
+            if not (parts.scheme == "https" or self.allow_plaintext_lan
+                    or _is_loopback(parts.hostname)):
+                raise RemoteVisionError(
+                    f"refusing to send env {TOKEN_ENV} over {parts.scheme}://{parts.hostname}")
+            headers["Authorization"] = f"Bearer {token}"
+        req = urllib.request.Request(url, data=json.dumps(payload).encode("utf-8"),
+                                     headers=headers, method="POST")
+        try:
+            with self._opener(req, timeout=self.timeout_s) as resp:
+                status = int(getattr(resp, "status", 200))
+                raw = resp.read(self.response_cap + 1)
+        except urllib.error.HTTPError as e:                    # 4xx/5xx (+ 30x: never followed)
+            raise RemoteVisionError(_scrub(f"HTTP {e.code}: {e.reason}")) from None
+        except (urllib.error.URLError, TimeoutError, socket.timeout) as e:
+            reason = getattr(e, "reason", e)
+            raise RemoteVisionError(_scrub(
+                f"transport error: {type(reason).__name__}: {reason}")) from None
+        except (OSError, http.client.HTTPException) as e:
+            raise RemoteVisionError(_scrub(
+                f"transport error: {type(e).__name__}: {e}")) from None
+        if not (200 <= status < 300):
+            raise RemoteVisionError(f"HTTP {status}")
+        if len(raw) > self.response_cap:                       # A2
+            raise RemoteVisionError(
+                f"response exceeds the {self.response_cap} byte cap")
+        try:
+            doc = json.loads(raw.decode("utf-8"))
+        except (UnicodeDecodeError, json.JSONDecodeError) as e:
+            raise RemoteVisionError(_scrub(f"malformed JSON: {type(e).__name__}")) from None
+        if not isinstance(doc, dict) or not isinstance(doc.get("detections"), list):
+            raise RemoteVisionError(
+                "schema: expected {'detections': [...], 'protocol': 1}")
+        proto = doc.get("protocol")
+        if isinstance(proto, bool) or not isinstance(proto, int):
+            raise RemoteVisionError(
+                f"response is missing the protocol echo: expected protocol={PROTOCOL}")
+        if proto != PROTOCOL:                                  # A1
+            raise RemoteVisionError(
+                f"protocol mismatch: adapter speaks {PROTOCOL}, response said {proto}")
+        self.last_protocol = proto
+        self.last_model = _clean_model(doc.get("model"))
+        self.last_ms = _clean_ms(doc.get("ms"))
+
+        all_entries = doc["detections"]
+        self.last_truncated = max(0, len(all_entries) - MAX_DETECTIONS)   # A2
+        entries = all_entries[:MAX_DETECTIONS]
+        dets: list[Detection] = []
+        skipped = 0
+        for item in entries:
+            parsed = _parse_entry(item, w, h)
+            if parsed is None:
+                skipped += 1
+                continue
+            dets.append(parsed)
+        self.last_skipped = skipped
+        if entries and not dets:
+            # All-invalid is a protocol failure, not an empty scene (threat #6/D2).
+            raise RemoteVisionError(f"all {skipped} detection entries malformed")
+        return dets

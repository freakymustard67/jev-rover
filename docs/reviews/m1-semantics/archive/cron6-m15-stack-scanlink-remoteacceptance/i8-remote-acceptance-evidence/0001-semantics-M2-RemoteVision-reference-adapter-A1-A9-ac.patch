+def test_a7_six_consecutive_failures_keep_worker_healthy(tmp_path, mock, monkeypatch):
+    """w4c driver sections D/E: 6 failures interleaved with recoveries, one runner."""
+    monkeypatch.setenv(ENDPOINT_ENV, mock.url)
+    vision = RemoteVision(timeout_s=0.15, labels=["mat", "bottle"])
+    runner = _runner(vision, tmp_path, failure_cooldown_s=1.0, min_interval_s=0.0,
+                     max_passes_per_min=200)
+    dead = f"http://127.0.0.1:{dead_port()}/detect"
+    modes = ["http500", "malformed", "schema", "allinvalid", "slow", "refused"]
+    try:
+        assert runner.maybe_pass(1.0, _ctx(), FRAME, force=True)   # baseline
+        assert _drain(runner, 1.0) is not None
+        errors = 0
+        for i, mode in enumerate(modes):
+            t = 10.0 + 5.0 * i
+            if mode == "refused":
+                monkeypatch.setenv(ENDPOINT_ENV, dead)
+            else:
+                mock.mode = mode
+                monkeypatch.setenv(ENDPOINT_ENV, mock.url)
+            assert runner.maybe_pass(t, _ctx(), FRAME, force=True)
+            errors += 1
+            assert _wait_error(runner, errors)
+            _consume_error(runner, t)
+            assert not runner.maybe_pass(t + 0.1, _ctx(), FRAME, force=True), \
+                "cooldown must block the next submit"
+            mock.mode = "ok"
+            monkeypatch.setenv(ENDPOINT_ENV, mock.url)
+            assert runner.maybe_pass(t + 1.0, _ctx(), FRAME, force=True)
+            assert _drain(runner, t + 1.0) is not None, f"recovery failed after {mode}"
+        stats = runner.stats()
+        assert stats["passes"] == 7 and stats["errors"] == 6
+        assert stats["passes_started"] == 13
+        assert stats["skipped"]["cooldown"] == 6
+        assert runner.worker._thread.is_alive()
+    finally:
+        runner.close()

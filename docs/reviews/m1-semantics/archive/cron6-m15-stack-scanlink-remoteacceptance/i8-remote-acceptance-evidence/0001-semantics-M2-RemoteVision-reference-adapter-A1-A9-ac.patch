+
+def _runner(vision, tmp_path, **overrides) -> SemanticsRunner:
+    cfg = RoomConfig()
+    cfg.name = ROOM
+    cfg.semantics = replace(cfg.semantics, store_dir=str(tmp_path), **overrides)
+    return SemanticsRunner(cfg, ROOM, vision)
+
+
+def _drain(runner: SemanticsRunner, t: float, deadline: float = 5.0):
+    end = time.time() + deadline
+    while time.time() < end:
+        res = runner.poll(t + 0.001)
+        if res is not None:
+            return res
+        time.sleep(0.005)
+    return None
+
+
+def _wait_error(runner: SemanticsRunner, want: int, deadline: float = 5.0) -> bool:
+    end = time.time() + deadline
+    while time.time() < end:
+        if runner.worker.errors >= want:
+            return True
+        time.sleep(0.005)
+    return False
+
+
+def _consume_error(runner: SemanticsRunner, t: float) -> None:
+    time.sleep(0.05)                                  # let the worker's _push land
+    assert runner.poll(t) is None, "an error result must not merge"
+

+def test_a6_sentinel_absent_from_artifacts_stats_and_errors(tmp_path, mock, monkeypatch):
+    monkeypatch.setenv(ENDPOINT_ENV, mock.url)
+    monkeypatch.setenv(TOKEN_ENV, SENTINEL)
+    vision = RemoteVision(timeout_s=2.0, labels=["mat", "bottle"])
+    runner = _runner(vision, tmp_path, failure_cooldown_s=1.0, min_interval_s=0.0,
+                     max_passes_per_min=200)
+    try:
+        assert runner.maybe_pass(1.0, _ctx(), FRAME, force=True)
+        merged = _drain(runner, 1.0)
+        assert merged is not None and len(merged.objects) == 2
+        mock.mode = "http500"                          # a failing pass must stay clean too
+        assert runner.maybe_pass(10.0, _ctx(), FRAME, force=True)
+        assert _wait_error(runner, 1)
+        _consume_error(runner, 10.0)
+        assert "HTTP 500" in (runner.worker.last_error or "")
+
+        artifacts = {
+            f"{ROOM}_latest.json": (tmp_path / f"{ROOM}_latest.json").read_text(),
+            "events.jsonl": (tmp_path / "events.jsonl").read_text(),
+            "stats()": json.dumps(runner.stats()),
+            "last_error": runner.worker.last_error or "",
+            "telemetry()": json.dumps(vision.telemetry()),
+        }
+        leaked = [name for name, text in artifacts.items() if SENTINEL in text]
+        assert not leaked, f"sentinel leaked into {leaked}"
+        # the mock really did receive the token (proof the pass was authenticated)
+        assert mock.requests and all(
+            r["authorization"] == f"Bearer {SENTINEL}" for r in mock.requests)
+    finally:
+        runner.close()

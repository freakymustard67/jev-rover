+def test_environment_proxies_are_ignored(mock, monkeypatch):
+    """threat #10: urllib honours http_proxy by default; our opener must not."""
+    evil = MockVisionServer().start()
+    try:
+        monkeypatch.setenv("http_proxy", evil.url)
+        monkeypatch.setenv("HTTP_PROXY", evil.url)
+        monkeypatch.delenv("no_proxy", raising=False)
+        monkeypatch.delenv("NO_PROXY", raising=False)
+        monkeypatch.setattr(urllib.request, "proxy_bypass", lambda host: False)
+        monkeypatch.setenv(ENDPOINT_ENV, mock.url)
+        vision = RemoteVision(timeout_s=2.0, labels=["mat"])
+        assert len(vision.infer(FRAME)) == 2
+        assert mock.requests and evil.requests == []
+    finally:
+        evil.stop()

+"""RemoteVision acceptance pack (M2 forward-landing, A1–A9) — loopback only.
+
+Drives the **real** ``SemanticsWorker``/``SemanticsRunner`` (semantics.py, PR tip
+bec1d91) against ``remotevision.RemoteVision`` talking to a stdlib loopback mock
+(127.0.0.1, ephemeral port). Nothing but 127.0.0.1 is contacted; no TLS, no
+external host, no proxies are exercised (see the report's limitations section).
+
+A-items (runs/20260928-2057/w4c-remotevision-threat.md §5):
+  A1 protocol echo + response model/ms telemetry
+  A2 size caps (1 MiB response, frame-px cap before encode, MAX_DETECTIONS=64)
+  A3 plaintext/TLS policy, endpoint hygiene, no redirects, no env proxies
+  A4 exactly one HTTP attempt per pass (failures go to the runner cooldown)
+  A5 max_passes_per_min=2 → ≤2 POSTs per simulated minute
+  A6 secret hygiene (mandatory): sentinel absent from artifacts/logs/errors
+  A7 failure isolation: timeout/500/malformed/schema/all-invalid/refused
+  A8 validation bounds (timeout, labels, endpoint) naming config key + env var
+  A9 static ``name``, artifact-safe
+
+Run:  PYTHONDONTWRITEBYTECODE=1 python -m pytest -q -p no:cacheprovider \
+          tests/test_remotevision_acceptance.py
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import re
+import socket
+import threading
+import time
+import urllib.request
+from dataclasses import replace
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from typing import Any
+
+import numpy as np
+import pytest
+
+import remotevision
+from config import ConfigError, RoomConfig
+from perception import Homography, SemanticContext
+from remotevision import (ENDPOINT_ENV, MAX_FRAME_PX, MAX_RESPONSE_BYTES, NAME,
+                          TOKEN_ENV, RemoteVision, RemoteVisionError)
+from semantics import MAX_DETECTIONS, SemanticsRunner
+
+ROOM = "remoteacc"
+FRAME = np.zeros((120, 160, 3), np.uint8)          # 160x120 px
+SENTINEL = "s3ntinel-t0ken-do-not-leak-9f1c"       # test fixture, not a real secret
+
+STUB_BODY: dict[str, Any] = {
+    "protocol": 1, "model": "stub-model", "ms": 5,
+    "detections": [{"label": "mat", "bbox_px": [20, 30, 60, 70], "score": 0.91},
+                   {"label": "bottle", "bbox_px": [80, 10, 100, 40], "score": 0.77}],
+}
+
+
+# --------------------------------------------------------------------- mock
+def _ok_body(model: str = "mock-model", ms: int = 7, protocol: Any = 1) -> dict:
+    return {"protocol": protocol, "model": model, "ms": ms,
+            "detections": [{"label": "mat", "bbox_px": [20, 30, 60, 70], "score": 0.91},
+                           {"label": "bottle", "bbox_px": [80, 10, 100, 40], "score": 0.77}]}
+
+
+def _many_body(n: int = 65) -> dict:
+    dets = []
+    for i in range(n):
+        col, row = i % 16, i // 16                       # boxes 9x9 on a 160x120 frame
+        x0, y0 = col * 10 + 1, row * 10 + 1
+        dets.append({"label": f"d{i:02d}", "bbox_px": [x0, y0, x0 + 8, y0 + 8], "score": 0.5})
+    return {"protocol": 1, "model": "mock", "ms": 3, "detections": dets}
+
+
+def _atcap_body() -> bytes:
+    prefix, suffix = b'{"protocol": 1, "detections": [], "pad": "', b'"}'
+    return prefix + b"x" * (MAX_RESPONSE_BYTES - len(prefix) - len(suffix)) + suffix
+
+
+def _toobig_body() -> bytes:
+    prefix, suffix = b'{"protocol": 1, "detections": [], "pad": "', b'"}'
+    return prefix + b"x" * (MAX_RESPONSE_BYTES + 1) + suffix
+
+
+class MockVisionServer:
+    """Loopback mock. Modes: ok / slow / http500 / malformed / schema / allinvalid /
+    protocol2 / noproto / proto_bool / hostilemodel / many65 / toobig / atcap / redirect."""
+
+    def __init__(self) -> None:
+        self.mode = "ok"
+        self.sleep_s = 0.6
+        self.redirect_to = ""
+        self.requests: list[dict] = []
+        self.bodies: list[bytes] = []
+        outer = self
+
+        class Handler(BaseHTTPRequestHandler):
+            protocol_version = "HTTP/1.1"
+
+            def log_message(self, *args):                # silence stderr noise
+                pass
+
+            def do_POST(self):
+                n = int(self.headers.get("Content-Length", "0") or "0")
+                body = self.rfile.read(n)
+                outer.requests.append({
+                    "path": self.path,
+                    "authorization": self.headers.get("Authorization", ""),
+                    "headers": {k: v for k, v in self.headers.items()},
+                    "content_type": self.headers.get("Content-Type", ""),
+                    "body_len": len(body),
+                    "mode": outer.mode,
+                })
+                outer.bodies.append(bytes(body))
+                mode = outer.mode
+                if mode == "slow":
+                    time.sleep(outer.sleep_s)
+                try:
+                    if mode == "http500":
+                        self._send(500, b"boom", "text/plain")
+                    elif mode == "malformed":
+                        self._send(200, b'{"protocol": 1, "detections": [oops',
+                                   "application/json")
+                    elif mode == "schema":
+                        self._send(200, json.dumps(
+                            {"protocol": 1, "detections": {"not": "a list"}}).encode(),
+                            "application/json")
+                    elif mode == "allinvalid":
+                        self._send(200, json.dumps(_ok_body() | {
+                            "detections": [{"label": "mat", "bbox_px": [5, 5, 5, 5],
+                                            "score": 0.9}]}).encode(), "application/json")
+                    elif mode == "protocol2":
+                        self._send(200, json.dumps(_ok_body(protocol=2)).encode(),
+                                   "application/json")
+                    elif mode == "noproto":
+                        self._send(200, json.dumps(
+                            {"model": "mock", "detections": []}).encode(), "application/json")
+                    elif mode == "proto_bool":
+                        self._send(200, json.dumps(_ok_body(protocol=True)).encode(),
+                                   "application/json")
+                    elif mode == "hostilemodel":
+                        self._send(200, json.dumps(
+                            {"protocol": 1, "model": "bad\nmodel\x1b[31m",
+                             "detections": []}).encode(), "application/json")
+                    elif mode == "many65":
+                        self._send(200, json.dumps(_many_body()).encode(), "application/json")
+                    elif mode == "toobig":
+                        self._send(200, _toobig_body(), "application/json")
+                    elif mode == "atcap":
+                        self._send(200, _atcap_body(), "application/json")
+                    elif mode == "redirect":
+                        self.send_response(302)
+                        self.send_header("Location", outer.redirect_to)
+                        self.send_header("Content-Length", "0")
+                        self.end_headers()
+                    else:
+                        self._send(200, json.dumps(_ok_body()).encode(), "application/json")
+                except (BrokenPipeError, ConnectionResetError):
+                    pass                                  # client timed out / read cap
+
+            def _send(self, code: int, payload: bytes, ctype: str):
+                self.send_response(code)
+                self.send_header("Content-Type", ctype)
+                self.send_header("Content-Length", str(len(payload)))
+                self.end_headers()
+                self.wfile.write(payload)
+
+        self._httpd = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
+        self.port = self._httpd.server_address[1]
+        self.url = f"http://127.0.0.1:{self.port}/detect"
+        self._thread = threading.Thread(target=self._httpd.serve_forever, daemon=True)
+
+    def start(self) -> "MockVisionServer":
+        self._thread.start()
+        return self
+
+    def stop(self) -> None:
+        self._httpd.shutdown()
+        self._httpd.server_close()
+
+
+def dead_port() -> int:
+    """A 127.0.0.1 port that will refuse connections."""
+    s = socket.socket()
+    s.bind(("127.0.0.1", 0))
+    port = s.getsockname()[1]
+    s.close()
+    return port
+
+
+# ------------------------------------------------------------------ stubs
+class _StubResponse:
+    def __init__(self, payload: bytes, status: int = 200):
+        self._payload, self.status = payload, status
+
+    def read(self, n: int = -1) -> bytes:
+        return self._payload if n is None or n < 0 else self._payload[:n]
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, *exc):
+        return False
+
+
+class _StubTransport:
+    """Injected transport (m2-design.md:351): captures requests, no socket."""
+
+    def __init__(self, body: dict | bytes | None = None, status: int = 200):
+        self.body = STUB_BODY if body is None else body
+        self.status = status
+        self.calls: list[urllib.request.Request] = []
+
+    def __call__(self, req, timeout=None):
+        self.calls.append(req)
+        payload = self.body if isinstance(self.body, bytes) else json.dumps(self.body).encode()
+        return _StubResponse(payload, self.status)
+
